# Alvos: newfront publicado e Docker local (vbconnection-hmg / vbconnection-local na :8080)
PLAYWRIGHT_NEWFRONT_URL=https://newfront.vbconnection.info
PLAYWRIGHT_DOCKER_URL=http://localhost:8080
PLAYWRIGHT_BASE_URL=https://newfront.vbconnection.info
PLAYWRIGHT_AUTH_URL=https://hmg.vbconnection.info/vbauto.api/auth
PLAYWRIGHT_API_URL=https://hmg.vbconnection.info/vbauto.api/api

# Massa padrão: auto.ui/playwright/fixtures/login.mass.json
# Copie este arquivo para .env e preencha só o que precisar sobrescrever.
# Não commitar senha real.

# Administrador (happy path / logout)
# PLAYWRIGHT_USER=
# PLAYWRIGHT_PASSWORD=
# PLAYWRIGHT_ADMIN_NAME=
# PLAYWRIGHT_ADMIN_EMAIL=
# PLAYWRIGHT_ADMIN_PERFIL=

# Credencial inválida
# PLAYWRIGHT_USER_INVALID=
# PLAYWRIGHT_PASSWORD_INVALID=

# 2FA
# PLAYWRIGHT_USER_2FA=
# PLAYWRIGHT_PASSWORD_2FA=
# PLAYWRIGHT_USER_2FA_EMAIL=

# Senha expirada
# PLAYWRIGHT_USER_EXPIRED=
# PLAYWRIGHT_PASSWORD_EXPIRED=

# Falha de rede (só preenche o formulário)
# PLAYWRIGHT_USER_OFFLINE=
# PLAYWRIGHT_PASSWORD_OFFLINE=

# Registro de contrato (massa gerada em factories/contratoFactory.ts a partir de config/ufsConfig.ts)
# APIs de matriz/combos/registrar são mockadas — não grava contrato real no HMG.

# Browsers: na primeira vez, rode `npm run install:browsers` (ou `npx playwright install chromium`).
