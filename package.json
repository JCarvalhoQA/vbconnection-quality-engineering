{
  "name": "vbconnection-quality-engineering",
  "version": "0.1.0",
  "private": true,
  "description": "Quality engineering and end-to-end test automation for VBConnection using Playwright and TypeScript, featuring automated regression testing, CI/CD integration, test reporting, and continuous quality assurance.",
  "scripts": {
    "test": "playwright test --project=vbconnection-newfront",
    "test:newfront": "playwright test --project=vbconnection-newfront",
    "test:docker": "playwright test --project=vbconnection-docker",
    "test:local": "playwright test --project=vbconnection-docker",
    "test:hmg": "playwright test --project=vbconnection-hmg",
    "test:ambos": "playwright test --project=vbconnection-docker --project=vbconnection-newfront",
    "test:smoke": "playwright test --project=vbconnection-newfront --grep \"@smoke\"",
    "test:ci": "playwright test --project=vbconnection-newfront",
    "test:ci:smoke": "playwright test --project=vbconnection-newfront --grep \"@smoke\"",
    "report:summary": "node scripts/summarize-e2e-results.mjs",
    "probe:hmg": "node scripts/probe-hmg.mjs",
    "validate:pipeline": "node scripts/validate-pipeline-local.mjs",
    "test:nova-ux": "playwright test --project=vbconnection-newfront --grep \"@novaux\"",
    "test:login": "playwright test --project=vbconnection-newfront --grep \"@login\"",
    "test:headed": "playwright test --project=vbconnection-newfront --grep \"@login\" --headed",
    "test:ui": "playwright test --ui --project=vbconnection-newfront",
    "test:contrato": "playwright test --project=vbconnection-newfront e2e/contratos",
    "test:contrato:ba": "playwright test --project=vbconnection-newfront e2e/contratos/registro/ba.spec.ts",
    "test:page02:ba": "playwright test --project=vbconnection-newfront e2e/contratos/page02/ba-estrutural.spec.ts --grep \"@mocked\"",
    "test:ci:mocked": "playwright test --project=vbconnection-newfront --grep-invert \"@live-readonly\"",
    "install:browsers": "playwright install chromium",
    "report": "playwright show-report",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "typecheck": "tsc --noEmit",
    "matriz:generate": "node scripts/generate-matriz-fixtures.mjs",
    "matriz:compare": "node scripts/compare-mock-matriz.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.10",
    "dotenv": "^16.4.7",
    "typescript": "^5.8.2"
  }
}
