# Copy this file to .env and override only what you need.
# Do not commit .env, tokens, passwords, cookies or authenticated storage state.

# local | the published newfront shell | the homologation host
# Local application: http://localhost:8080
PLAYWRIGHT_LOCAL_URL=http://localhost:8080
PLAYWRIGHT_DOCKER_URL=http://localhost:8080

# Published frontend used by the default suite (npm test).
PLAYWRIGHT_NEWFRONT_URL=https://newfront.vbconnection.info
PLAYWRIGHT_BASE_URL=https://newfront.vbconnection.info

# Homologation host. Opt in with: npm run test:hmg
PLAYWRIGHT_HMG_URL=https://hmg.vbconnection.info

# API used when a scenario calls the backend directly. Login E2E mocks these routes.
PLAYWRIGHT_AUTH_URL=https://hmg.vbconnection.info/vbauto.api/auth
PLAYWRIGHT_API_URL=https://hmg.vbconnection.info/vbauto.api/api

# Optional one-shot target for scripts/probe-hmg.mjs and CI.
# Allowed hosts: newfront.vbconnection.info, hmg.vbconnection.info
# PLAYWRIGHT_TARGET_URL=https://newfront.vbconnection.info

# Optional credential overrides. Leave unset to use the mock personas in
# fixtures/login.mass.json. Never commit real usernames or passwords.
# PLAYWRIGHT_USER=
# PLAYWRIGHT_PASSWORD=
# PLAYWRIGHT_ADMIN_NAME=
# PLAYWRIGHT_ADMIN_EMAIL=
# PLAYWRIGHT_ADMIN_PERFIL=

# PLAYWRIGHT_USER_INVALID=
# PLAYWRIGHT_PASSWORD_INVALID=
# PLAYWRIGHT_USER_2FA=
# PLAYWRIGHT_PASSWORD_2FA=
# PLAYWRIGHT_USER_2FA_EMAIL=
# PLAYWRIGHT_USER_EXPIRED=
# PLAYWRIGHT_PASSWORD_EXPIRED=
# PLAYWRIGHT_USER_OFFLINE=
# PLAYWRIGHT_PASSWORD_OFFLINE=

# Master — live-readonly only (Gate 0–3 / PAGE-02 structural). Never commit values.
# Required by GitHub Environment `live-readonly`, not by pull requests.
# PLAYWRIGHT_MASTER_USER=
# PLAYWRIGHT_MASTER_PASSWORD=
# PLAYWRIGHT_MASTER_NAME=
# PLAYWRIGHT_MASTER_EMAIL=
# PLAYWRIGHT_MASTER_PERFIL=MASTER
# PLAYWRIGHT_GATE0_LIVE=0
# PLAYWRIGHT_GATE1_LIVE=0
# PLAYWRIGHT_GATE2_LIVE=0
# PLAYWRIGHT_GATE3_LIVE=0
# PLAYWRIGHT_PAGE02_STRUCTURAL_LIVE=0
